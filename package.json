{
  "name": "@sky_wing_dn/dsh-fairy-zzz",
  "version": "2.1.1",
  "description": "Unofficial Zenless Zone Zero \"Fairy\" H.D.D skin for the DSH Web UI: boot animation, animated eye badge, hour-based greeting, Wire-Net Terminal host skin, always-on fee readout, and optional local GPT-SoVITS voice. Starts from AssassinVIX/fairy-zzz-plugin (MIT); eye artwork from Chengzhibense/Fairy-DSH (Apache-2.0); changelog in docs/CHANGELOG.md.",
  "type": "module",
  "license": "MIT",
  "author": "SkyWingDN; original plugin by AssassinVIX",
  "contributors": [
    {
      "name": "AssassinVIX",
      "url": "https://github.com/AssassinVIX"
    },
    {
      "name": "Chengzhibense (Fairy-DSH, Apache-2.0)",
      "url": "https://github.com/Chengzhibense/Fairy-DSH"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkyWingDN/dsh-fairy-zzz.git"
  },
  "homepage": "https://github.com/SkyWingDN/dsh-fairy-zzz#readme",
  "bugs": {
    "url": "https://github.com/SkyWingDN/dsh-fairy-zzz/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "theme",
    "skin",
    "zenless-zone-zero",
    "fairy",
    "tts",
    "performance",
    "usage",
    "balance",
    "light-theme",
    "drag",
    "host-skin",
    "wire-net-terminal",
    "zzz"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./assets/icon-180.png"
  },
  "icon": "assets/icon-180.png",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets",
    "presets",
    "screenshots",
    "screenshots.json",
    "icon.svg",
    "install-windows.ps1",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE-fairy-dsh.md",
    "licenses",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
