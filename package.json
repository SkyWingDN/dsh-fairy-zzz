{
  "name": "dsh-fairy-zzz",
  "version": "1.1.0",
  "description": "Unofficial, performance-optimized edition of the Zenless Zone Zero Fairy H.D.D skin for the DSH Web UI: boot animation, animated eye core, time-of-day greeting, idle breathing, eye flicker and signal glitches, clip-based thinking eyelid, plus optional local GPT-SoVITS voice. Modified by SkyWingDN from AssassinVIX/fairy-zzz-plugin; eye art and motion adapted from Chengzhibense/Fairy-DSH.",
  "type": "module",
  "license": "MIT",
  "author": "SkyWingDN (performance edition); dsh-fairy-zzz contributors / AssassinVIX (original plugin)",
  "contributors": [
    {
      "name": "AssassinVIX",
      "url": "https://github.com/AssassinVIX"
    },
    {
      "name": "Chengzhibense (Fairy-DSH, Apache-2.0)",
      "url": "https://github.com/Chengzhibense/Fairy-DSH"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkyWingDN/dsh-fairy-zzz.git"
  },
  "homepage": "https://github.com/SkyWingDN/dsh-fairy-zzz#readme",
  "bugs": {
    "url": "https://github.com/SkyWingDN/dsh-fairy-zzz/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "theme",
    "skin",
    "zenless-zone-zero",
    "fairy",
    "tts",
    "performance"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./assets/icon-180.png"
  },
  "icon": "assets/icon-180.png",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets",
    "presets",
    "screenshots",
    "screenshots.json",
    "icon.svg",
    "install-windows.ps1",
    "README.md",
    "LICENSE",
    "NOTICE-fairy-dsh.md",
    "licenses",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
